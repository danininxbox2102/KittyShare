{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "strict": true,
    "jsx": "preserve", "resolveJsonModule": true, "allowImportingTsExtensions": true,
    "isolatedModules": true, "esModuleInterop": true, "skipLibCheck": true,
    "types": ["vite/client"], "noEmit": true
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "capacitor.config.ts", "vite.config.ts"]
}
